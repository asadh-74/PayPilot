# Local development only. Never commit a real .env file.
DATABASE_URL=sqlite:///./paypilot.db
REQUIRE_MYSQL=false
COOKIE_SECURE=false
DEMO_ENABLED=false
PAYMENT_MODE=manual
# Set a unique password of at least 16 characters before admin login.
ADMIN_PASSWORD=
# Hosted: URL-encode credentials; use a dedicated PayPilot database/user.
# DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:PORT/paypilot
# MYSQL_SSL_CA must contain the Aiven project CA PEM certificate.
MYSQL_SSL_CA=
APP_BASE_URL=https://YOUR-SERVICE.onrender.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Optional; public demos always use the offline parser.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_HOST=
